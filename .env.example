# Free cloud AI providers. Groq is tried first; OpenRouter is the fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Your Amazon Associates tracking ID. This is public in generated links.
AMAZON_ASSOCIATE_TAG=pickformehub-20

# Hostinger typically provides PORT; 3000 is convenient for local development.
PORT=3000
